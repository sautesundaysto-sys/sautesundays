---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Newsletter from "../components/Newsletter.astro";
import NextUp from "../components/NextUp.astro";
import Icon from "../components/Icon.astro";
import autumnScene from "../assets/Website Banner.png";
import { PROOF, NEXT_EVENT, REACH } from "../config/theme.config.ts";
import {
  SITE,
  categories,
  featuredPost,
  sortedPosts,
  getCategory,
  formatDate,
} from "../lib/blog-data.js";

const featured = await featuredPost();
const featuredCategory = getCategory(featured.category);

// Each night has two posts: the recap, and its cookbook highlight. Surfacing
// both near the top read as a duplicate, so the companion is linked from the
// featured card instead of repeating in the grid. Older nights pair by slug
// (cookbook-<recap>); newer ones name the pair explicitly in frontmatter,
// which frees the slugs to be written for search rather than for this lookup.
const allPosts = await sortedPosts();
const companionSlug = featured.companion || `cookbook-${featured.slug}`;
const companion = allPosts.find((post) => post.slug === companionSlug);
const latest = allPosts.filter(
  (post) => post.slug !== featured.slug && post.slug !== companion?.slug,
);

// Event structured data, built from the same NEXT_EVENT entry the "Next up"
// block renders, so there is only one place to update each month.
const eventJsonLd = NEXT_EVENT.title && NEXT_EVENT.startDateTime
  ? {
      "@context": "https://schema.org",
      "@type": "Event",
      name: NEXT_EVENT.title,
      description: NEXT_EVENT.schemaDescription,
      startDate: NEXT_EVENT.startDateTime,
      ...(NEXT_EVENT.endDateTime ? { endDate: NEXT_EVENT.endDateTime } : {}),
      // The single strongest thing we can tell a machine about this event.
      isAccessibleForFree: true,
      maximumAttendeeCapacity: Number(REACH.seats),
      url: new URL(NEXT_EVENT.rsvpUrl, SITE.url).toString(),
      inLanguage: "en-CA",
      eventAttendanceMode: "https://schema.org/OfflineEventAttendanceMode",
      eventStatus: "https://schema.org/EventScheduled",
      location: {
        "@type": "Place",
        ...(NEXT_EVENT.locationName ? { name: NEXT_EVENT.locationName } : {}),
        address: {
          "@type": "PostalAddress",
          ...(NEXT_EVENT.locationStreet ? { streetAddress: NEXT_EVENT.locationStreet } : {}),
          addressLocality: "Toronto",
          addressRegion: "ON",
          addressCountry: "CA",
        },
      },
      organizer: {
        "@type": "Organization",
        name: SITE.name,
        url: SITE.url,
      },
      offers: {
        "@type": "Offer",
        price: "0",
        priceCurrency: "CAD",
        availability: "https://schema.org/InStock",
        // rsvpUrl is relative while it points at /contact, between Luma pages.
        url: new URL(NEXT_EVENT.rsvpUrl, SITE.url).toString(),
        // Only set once we know the date, so we are not telling search engines
        // a seat is bookable before RSVPs actually open.
        ...(NEXT_EVENT.rsvpOpensDateTime ? { validFrom: NEXT_EVENT.rsvpOpensDateTime } : {}),
      },
      image: [new URL("/og-default.jpg", SITE.url).toString()],
    }
  : undefined;
---

<BaseLayout
  title={`${SITE.name} - Toronto's Cookbook Club`}
  description="Sauté Sundays is Toronto's cookbook club. Bring one dish, enjoy 35 dishes, and spend an evening with people who love food. Free to attend. Spots go fast."
  canonical="/"
  jsonLd={eventJsonLd}
  flushFooter
>
  <section class="relative -mt-[calc(4rem+2px)] min-h-[78svh] overflow-hidden border-b border-border/60 pt-[calc(4rem+2px)] sm:min-h-[760px]">
    <Image
      src={autumnScene}
      alt="Sauté Sundays Toronto cookbook club, a full table of homemade dishes"
      class="absolute inset-0 h-full w-full object-cover object-right sm:object-center"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      width={1600}
      widths={[640, 960, 1280, 1600]}
      sizes="100vw"
      format="webp"
      quality={50}
    />
    <div
      aria-hidden="true"
      class="absolute inset-0 bg-gradient-to-b from-[#f2eeeb]/95 via-[#f2eeeb]/88 to-[#f2eeeb]/70 dark:from-[#383a37]/95 dark:via-[#383a37]/88 dark:to-[#383a37]/70 sm:hidden"
    />
    <div
      aria-hidden="true"
      class="absolute inset-y-0 left-0 hidden w-2/3 bg-gradient-to-r from-[#f2eeeb]/90 via-[#f2eeeb]/50 to-transparent dark:from-[#383a37]/90 dark:via-[#383a37]/50 dark:to-transparent sm:block"
    />
    <div class="relative mx-auto flex min-h-[66svh] max-w-6xl items-center px-5 py-16 sm:min-h-[680px] sm:py-24">
      <div class="max-w-4xl text-[#1a1c1a] drop-shadow-[0_1px_3px_rgba(255,255,255,0.8)] dark:text-[#f2eeeb] dark:drop-shadow-[0_1px_3px_rgba(0,0,0,0.7)]">
        <h1 class="font-serif text-[2.5rem] font-bold leading-[1.02] sm:text-6xl lg:text-7xl">
          Toronto's
          <span class="italic text-primary dark:text-white"> cookbook club</span>
          : bring one dish,
          <span class="italic text-primary dark:text-white"> enjoy 35 dishes</span>.
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-[#1a1c1a]/80 dark:text-[#f2eeeb]/80">
          Every month, Toronto home cooks gather to cook from the same cookbook and share what they made. One book, thirty-five interpretations, one room. Free to attend. Running since 2025. Spots go fast.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-4">
          
           <a href="https://lu.ma/sautesundaysto"
            class="inline-flex min-h-11 items-center gap-2 rounded-full bg-[#1a1c1a] px-6 py-3 text-sm font-semibold text-[#f2eeeb] transition-colors hover:opacity-90 dark:bg-[#f2eeeb] dark:text-[#1a1c1a]"
          >
            RSVP to the next event
            <Icon name="arrow-right" class="h-3.5 w-3.5" />
          </a>
          
            <a href="/blog"
            class="inline-flex min-h-11 items-center gap-2 rounded-full border border-[#1a1c1a] px-6 py-3 text-sm font-semibold text-[#1a1c1a] transition-colors hover:bg-[#f2eeeb]/20 dark:border-[#f2eeeb] dark:text-[#f2eeeb] dark:hover:bg-[#1a1c1a]/20"
          >
            See past events
          </a>
        </div>
        <p class="mt-6 text-sm font-medium text-[#1a1c1a] dark:text-[#f2eeeb]">
          {PROOF.seats} seats. {PROOF.tables} tables since {PROOF.since}.
          {PROOF.sellOutTime && ` Every one sold out in ${PROOF.sellOutTime}.`}
        </p>
      </div>
    </div>
  </section>

  <NextUp />

  <section id="calendar" class="scroll-mt-20 border-b border-border/60">
    <div class="mx-auto max-w-3xl px-5 py-16">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">What's on the books</h2>
      <p class="mt-2 text-muted-foreground">
        Every night we have scheduled. Subscribe on Luma and each new one lands in your calendar.
      </p>

      <div class="mt-6 overflow-hidden rounded-lg border border-border bg-muted">
        <iframe
          src="https://luma.com/embed/calendar/cal-MPOdvnBoHzwltEq/events"
          title="Sauté Sundays events calendar"
          class="block h-[540px] w-full border-0 sm:h-[450px]"
          loading="lazy"
          allowfullscreen></iframe>
      </div>

      <p class="mt-3 text-center text-sm text-muted-foreground">
        Calendar not loading? <a href="https://lu.ma/sautesundaysto" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Open it on Luma &#8599;</a>
      </p>
    </div>
  </section>

  <section class="border-b border-border/60 bg-muted/40">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">The latest night</div>
      <article class="mt-5 overflow-hidden rounded-xl border border-border bg-background">
        <a href={`/blog/${featured.slug}`} class="group block" aria-label={`Read ${featured.title}`}>
          <div class="aspect-[16/9] overflow-hidden bg-muted sm:aspect-[21/9]">
            {
              featured.thumbnail && (
                <Image
                  src={featured.thumbnail}
                  alt={featured.title}
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                  width={1200}
                  widths={[560, 880, 1200]}
                  sizes="(min-width: 1024px) 1100px, calc(100vw - 40px)"
                  format="webp"
                  quality={64}
                />
              )
            }
          </div>
        </a>
        <div class="p-6 sm:p-10">
          <div class="flex items-center gap-3 text-xs uppercase tracking-wider text-muted-foreground">
            {
              featuredCategory && (
                <a href={`/categories/${featuredCategory.slug}`} class="inline-flex min-h-11 items-center text-primary hover:underline">
                  {featuredCategory.name}
                </a>
              )
            }
            <span>&middot;</span>
            <time datetime={featured.date}>{formatDate(featured.date)}</time>
          </div>
          <a href={`/blog/${featured.slug}`} class="mt-1 block py-2.5">
            <h2 class="font-serif text-3xl font-semibold leading-tight hover:text-primary sm:text-5xl">
              {featured.title}
            </h2>
          </a>
          <p class="mt-3 text-lg leading-relaxed text-muted-foreground sm:text-xl">{featured.excerpt}</p>
          <div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-2">
            <a href={`/blog/${featured.slug}`} class="inline-flex min-h-11 items-center gap-2 rounded-full bg-primary px-5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90">
              Read the recap <Icon name="arrow-right" class="h-3.5 w-3.5" />
            </a>
            {
              companion && (
                <a href={`/blog/${companion.slug}`} class="inline-flex min-h-11 items-center text-sm text-muted-foreground hover:text-foreground">
                  Or the cookbook behind it &rarr;
                </a>
              )
            }
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="border-b border-border/60">
    <div class="mx-auto max-w-3xl px-5 py-16">
      <h2 class="font-serif text-3xl font-semibold sm:text-4xl">Never been?</h2>
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        Here's the whole thing. You RSVP. We tell you the cookbook. You pick a recipe from the sign-up sheet so nobody
        doubles up. You cook it at home, bring it to the location, and we put it all out and eat our way through it together.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        You don't need to be a good cook. You don't need to know anyone. Half the room is new every month and the food
        is a very easy thing to talk about.
      </p>
      <div class="mt-10 grid gap-8 sm:grid-cols-2">
        <figure class="border-l-2 border-primary pl-5">
          <blockquote class="font-serif text-lg leading-relaxed">
            Thanks for hosting!! It was so much fun and so nice meeting everyone :)
          </blockquote>
          <figcaption class="mt-3 text-sm text-muted-foreground">Marie, February 2026</figcaption>
        </figure>
        <figure class="border-l-2 border-primary pl-5">
          <blockquote class="font-serif text-lg leading-relaxed">
            Thank you so much for hosting us. You have an amazing energy and you attracted an awesome crowd of ladies.
            Exactly what I needed this weekend 💜
          </blockquote>
          <figcaption class="mt-3 text-sm text-muted-foreground">Nada, October 2025</figcaption>
        </figure>
      </div>
      <a
        href="/faq"
        class="mt-10 inline-flex min-h-11 items-center gap-2 rounded-md border border-border px-5 text-sm font-medium hover:bg-muted"
      >
        Read the FAQ <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-5 py-16" data-home-latest>
    <div class="flex flex-wrap items-center justify-between gap-4">
      <div>
        <h2 class="font-serif text-2xl font-semibold">Past Events</h2>
        <p class="mt-1 text-sm text-muted-foreground">Every table since 2025.</p>
      </div>
      <div class="flex flex-wrap gap-2">
        <button
          type="button"
          data-home-filter=""
          class="inline-flex min-h-11 items-center rounded-full border px-4 text-xs transition-colors border-foreground bg-foreground text-background"
        >
          All
        </button>
        {
          categories.map((category) => (
            <button
              type="button"
              data-home-filter={category.slug}
              class="inline-flex min-h-11 items-center rounded-full border px-4 text-xs transition-colors border-border text-muted-foreground hover:text-foreground"
            >
              {category.name}
            </button>
          ))
        }
      </div>
    </div>

    <div data-home-empty class="mt-12 rounded-md border border-dashed border-border py-16 text-center text-muted-foreground" hidden>
      Nothing here yet in this section.
    </div>

    <div class="mt-10 grid gap-10 sm:grid-cols-2 lg:grid-cols-3">
      {latest.map((post, index) => <PostCard post={post} hidden={index >= 6} />)}
    </div>

    <div class="mt-12 text-center">
      <a href="/blog" class="inline-flex min-h-11 items-center gap-2 rounded-md border border-border px-5 text-sm font-medium hover:bg-muted">
        All past events <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </div>
  </section>

  <Newsletter embed />
</BaseLayout>

<script>
  const latest = document.querySelector("[data-home-latest]");
  if (latest) {
    const buttons = [...latest.querySelectorAll("[data-home-filter]")];
    const cards = [...latest.querySelectorAll("[data-post-card]")];
    const empty = latest.querySelector("[data-home-empty]");
    const activeClasses = ["border-foreground", "bg-foreground", "text-background"];
    const inactiveClasses = ["border-border", "text-muted-foreground", "hover:text-foreground"];

    const setActive = (button, active) => {
      button.classList.toggle(activeClasses[0], active);
      button.classList.toggle(activeClasses[1], active);
      button.classList.toggle(activeClasses[2], active);
      inactiveClasses.forEach((className) => button.classList.toggle(className, !active));
    };

    const filterCards = (category) => {
      let visible = 0;
      cards.forEach((card) => {
        const match = !category || card.dataset.category === category;
        const show = match && visible < 6;
        card.hidden = !show;
        if (match) visible += 1;
      });
      if (empty) empty.hidden = visible > 0;
      buttons.forEach((button) => setActive(button, button.dataset.homeFilter === category));
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => filterCards(button.dataset.homeFilter || ""));
    });
  }
</script>
