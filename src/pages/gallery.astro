---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../lib/blog-data.js";
import { gallery as images } from "../data/gallery.js";
---

<BaseLayout
  title={`Gallery - ${SITE.name}`}
  description="Photos from Sauté Sundays, Toronto's cookbook club. A year of monthly potluck gatherings, one cookbook at a time."
  canonical="/gallery"
>
  <div class="mx-auto max-w-6xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "Gallery" }]} />

    <header class="mt-6 mb-12">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Gallery</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold leading-[1.05]">
        A year of good tables.
      </h1>
      <p class="mt-4 max-w-xl text-muted-foreground">
        Every month, one cookbook, 35+ people, and a table full of dishes nobody planned together.
      </p>
    </header>

    {images.length === 0 && (
      <div class="rounded-md border border-dashed border-border py-24 text-center text-muted-foreground">
        Photos coming soon. Check back after our next event.
      </div>
    )}

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {images.map((image) => (
        <figure class="group relative aspect-square overflow-hidden rounded-lg bg-muted">
          <Image
            src={image.src}
            alt={image.alt}
            class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
            widths={[400, 800, 1200]}
            sizes="(min-width: 1024px) 360px, (min-width: 640px) 45vw, calc(100vw - 40px)"
            format="webp"
            quality={62}
            loading="lazy"
          />
          <figcaption class="pointer-events-none absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent p-3 text-xs font-medium text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100">
            {image.event}
          </figcaption>
        </figure>
      ))}
    </div>

    <div class="mt-12 text-center">
      
        <a href="https://www.instagram.com/sautesundays.to/"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-3 text-sm font-semibold hover:bg-muted transition-colors"
      >
        See more on Instagram ↗
      </a>
    </div>
  </div>
</BaseLayout>