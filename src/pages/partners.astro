---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { REACH, CONTACT } from "../config/theme.config.ts";
import heroPhoto from "../assets/gallery/IMG_9483.JPG";
import roomPhoto from "../assets/gallery/C3D8722C-A122-4A1B-87AC-D46C5B11B5DD.JPG";

const stats = [
  { label: "Seats, every month", value: REACH.seats },
  { label: "Gone in 24 hours", value: REACH.goneIn24Hours },
  { label: "Subscribers", value: REACH.subscribers },
  { label: "Open rate", value: REACH.openRate },
];

const ways = [
  {
    title: "Product for the room",
    body: "Drinks, ingredients or cookware for one month's event. Everyone there cooks, so nothing goes to waste and nothing goes unnoticed.",
    featured: false,
  },
  {
    title: "Product to take home",
    body: "35 people leaving with your thing in their hands and a recipe they just cooked.",
    featured: false,
  },
  {
    title: "A month of your own",
    body: "Your name on one event: in the title, on the RSVP page, in the newsletter, and in the write-up afterwards.",
    featured: true,
  },
  {
    title: "Cover the running costs",
    body: "Plates, permits, printing, the website. Unglamorous, and the reason a free event stays free. Happy to name you for it.",
    featured: false,
  },
];

const pastPartners = ["Jrew's, our home on Niagara St", "Danu Social House", "Sunny Daze", "SocialSip Toronto"];
---

<BaseLayout
  title="Partner with Sauté Sundays"
  description="35 Toronto home cooks, every month, all of them cooking. Product, sponsorship and community partnerships with Toronto's cookbook club."
  canonical="/partners"
  ogImage="/og-partners.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageAlt="Four guests sitting together with their plates at a Sauté Sundays table"
>
  <div class="mx-auto max-w-[680px] px-5 py-12 sm:py-16">
    <section>
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Sauté Sundays</div>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-[1.08] sm:text-5xl">
        35 people who will actually cook with your products
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        Not a logo on a banner. Our members go home and make something. A knife, a bottle, a bag of something they've
        never used gets used, photographed and talked about.
      </p>
      <a
        href="#form"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
      >
        Talk to us
        <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </section>

    <figure class="mt-10 overflow-hidden rounded-lg bg-muted">
      <Image
        src={heroPhoto}
        alt="Four guests sitting together with their plates at Sauté Sundays, the room busy behind them"
        class="h-full w-full object-cover"
        widths={[400, 680, 1000]}
        sizes="(min-width: 720px) 640px, calc(100vw - 40px)"
        format="webp"
        quality={66}
        loading="eager"
      />
    </figure>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">The room</h2>
      <dl class="mt-6 grid grid-cols-2 gap-3">
        {
          stats.map((stat) => (
            <div class="rounded-lg border border-border bg-muted/40 px-4 py-5">
              <dt class="text-xs uppercase tracking-wider text-muted-foreground">{stat.label}</dt>
              <dd class="mt-1 font-serif text-2xl font-semibold sm:text-3xl">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        Over 50 members have come back more than once. The newsletter is mostly food writing rather than event
        announcements, so people read it because they want to.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Four ways in</h2>
      <div class="mt-6 space-y-4">
        {
          ways.map((way, index) => (
            <div
              class:list={[
                "rounded-lg p-5",
                way.featured ? "border-2 border-primary bg-primary/5" : "border border-border bg-muted/30",
              ]}
            >
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <h3 class="font-serif text-lg font-semibold">
                  {index + 1}. {way.title}
                </h3>
                {way.featured && (
                  <span class="rounded-full bg-primary px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-primary-foreground">
                    Most visible
                  </span>
                )}
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{way.body}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        Most of our partnerships are product rather than cash. Tell us roughly what you have in mind and we'll tell you
        honestly what it gets.
      </p>
    </section>

    <figure class="mt-10 overflow-hidden rounded-lg bg-muted">
      <Image
        src={roomPhoto}
        alt="A guest holding a full plate above a tray of arroz con pollo at the Sauté Sundays table"
        class="h-full w-full object-cover"
        widths={[400, 680, 1000]}
        sizes="(min-width: 720px) 640px, calc(100vw - 40px)"
        format="webp"
        quality={66}
        loading="lazy"
      />
    </figure>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Who we've worked with</h2>
      <ul class="mt-6 flex flex-wrap gap-x-3 gap-y-2 text-sm text-muted-foreground">
        {
          pastPartners.map((partner, index) => (
            <li>
              {partner}
              {index < pastPartners.length - 1 && <span class="ml-3 text-border">&middot;</span>}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mt-14">
      <blockquote class="border-l-2 border-primary pl-5">
        <p class="font-serif text-xl leading-relaxed sm:text-2xl">
          The monthly potluck is free and stays free. Nobody has ever been charged to bring a dish. Partnerships pay for
          the room, never the plate.
        </p>
      </blockquote>
    </section>

    <section id="form" class="mt-16 scroll-mt-24">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Get in touch</h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">We reply within two days.</p>
      <div class="mt-6 rounded-lg bg-[#f2eeeb] p-4 dark:bg-[#f2eeeb] sm:p-6">
        <iframe
          src="https://tally.so/embed/4405o5?alignLeft=1&hideTitle=1&transparentBackground=1"
          width="100%"
          height="600"
          class="block h-[760px] w-full sm:h-[600px]"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          loading="lazy"
          title="Brand partnership enquiry form"></iframe>
      </div>
      <p class="mt-3 text-center text-sm text-muted-foreground">
        Form not loading?
        <a href="https://tally.so/r/4405o5" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Open it in a new tab &#8599;</a>
        or email <a href={`mailto:${CONTACT.email}`} class="text-primary hover:underline">{CONTACT.email}</a>.
      </p>
    </section>

    <p class="mt-14 text-center text-sm text-muted-foreground">
      Run a restaurant?
      <a href="/restaurant-nights" class="text-primary hover:underline">We do hands-on nights &rarr;</a>
    </p>
  </div>
</BaseLayout>
