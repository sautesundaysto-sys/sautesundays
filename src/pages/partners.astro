---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { REACH, CONTACT } from "../config/theme.config.ts";
import { sortedPosts } from "../lib/blog-data.js";
import heroPhoto from "../assets/gallery/IMG_9483.JPG";
import roomPhoto from "../assets/gallery/C3D8722C-A122-4A1B-87AC-D46C5B11B5DD.JPG";

// One recap per night, so the count of them is the count of nights. Derived
// rather than typed, so it does not need remembering after each event.
const posts = await sortedPosts();
const nightsRun = posts.filter((post) => post.category === "event-recap").length;

// Open rate first: it is a quality number. A raw audience size invites the
// reach comparison this page does not want.
const stats = [
  { label: "Median newsletter open rate", value: REACH.openRateMedian },
  { label: "Events sold out, each within three days", value: `${nightsRun}/${nightsRun}` },
  { label: "Unique members have attended at least twice", value: REACH.repeatMembers },
  { label: "Current member places at Jrew's", value: REACH.seats },
];

const ways = [
  {
    title: "Product for the room",
    badge: "The easiest place to start",
    body: "Enough product for approximately 35 servings, with the final quantity agreed according to the format. This works well for drinks, condiments, snacks, dips, and anything that can be opened and shared during the evening.",
  },
  {
    title: "Product to take home",
    badge: "",
    body: "Thirty-five units, handed to attendees during or at the end of the event. Members can take the product home and try it in their own time. We invite them to tag Sauté Sundays and the brand if they choose to share their experience.",
  },
  {
    title: "A month of your own",
    badge: "",
    body: "$350 CAD plus product. Your brand appears in the event title, on the RSVP page, in the announcement newsletter, in an Instagram feed post and story, and in the post-event recap. That creates repeated visibility across roughly six weeks.",
  },
];

// Wide on purpose: the table scrolls inside its own container rather than
// pushing the page sideways.
const deliverables = [
  ["Brand contribution", "Product for approximately 35 servings", "35 take-home units", "$350 CAD plus product"],
  ["Newsletter", "One inclusion", "One inclusion", "Announcement and post-event recap"],
  ["Instagram", "At least one story", "At least one story", "One feed post and at least one story"],
  ["Event title and RSVP page", "—", "—", "Brand named"],
  ["Photography and reporting", "5–10 selected photographs within seven days, plus final headcount", "Same", "Same"],
  ["Community feedback", "When agreed in advance", "When agreed in advance", "When agreed in advance"],
  ["Category exclusivity", "Yes, within the agreed category", "Yes", "Yes"],
];

const howItWorks = [
  {
    term: "One official partner per agreed product category",
    detail:
      "We do not promote a competing brand from that category in the event copy or selected sponsor photographs. Members still choose their own recipes and ingredients, so they remain free to bring the products they normally use.",
  },
  {
    term: "We plan six to eight weeks ahead",
    detail:
      "Product should arrive at least two weeks before the event. A pre-event cooking format may need more lead time.",
  },
  {
    term: "5 to 10 selected photographs within seven days",
    detail:
      "We can include at least one clear product image when requested. The photographs document the event as it happens. Usage details are included in the Partnership Terms shared before confirmation.",
  },
  {
    term: "We only confirm products that fit",
    detail:
      "The product needs a natural place in the room and the featured cookbook. When another month would work better, we will say so and suggest it.",
  },
];
const faqs = [
  {
    question: "Can we come to the night?",
    answer:
      "Yes, by arrangement. Brand guests bring a dish and participate in the evening. We cap brand attendance at two people across the event, so when two brands are involved that usually means one guest from each. A brief two or three minute introduction is welcome. We keep the room free of booths, sales tables, and direct pitches.",
  },
  {
    question: "Can we get your mailing list?",
    answer:
      "We keep member details private. Brand mentions go through Sauté Sundays. When agreed in advance, we can ask one short, voluntary question in our WhatsApp community and share an anonymous summary.",
  },
  {
    question: "Will our product be in the photographs?",
    answer:
      "Yes. We can include at least one clear product image in the final selection when requested. The remaining photographs document the evening as it happens.",
  },
  {
    question: "Can members cook with the product before the event?",
    answer:
      "Yes, when the product suits the featured cookbook and there is enough lead time. We distribute it early to interested members, agree the number in advance, and report actual participation afterwards.",
  },
  {
    question: "Will members post about the product?",
    answer:
      "Some members share their dishes or product experience and tag Sauté Sundays. We encourage that and reshare relevant posts, while keeping participation voluntary.",
  },
  {
    question: "How many people will attend?",
    answer:
      "We release 35 member places at Jrew's and use the waitlist to fill late cancellations where possible. Final attendance can vary because the event is free. Every partner receives the final headcount afterwards.",
  },
  {
    question: "What does it cost?",
    answer:
      "Product for the room means enough for approximately 35 servings. Product to take home means 35 units. A named month costs $350 CAD plus product. Support for running costs is quoted case by case.",
  },
  {
    question: "What if our product does not suit the cookbook?",
    answer:
      "We will suggest a month or featured cookbook that gives the product a more natural place in the room.",
  },
  {
    question: "Can we partner more than once?",
    answer: "Yes. Repeat partners receive first pick of suitable upcoming months.",
  },
  {
    question: "Do you work with alcohol brands?",
    answer:
      "Only at a licensed venue. Jrew's is licensed, and we confirm the product and service plan before agreeing the partnership.",
  },
];

// The questions are on the page, so they can be marked up. Built from the same
// array the page renders, so the two cannot drift.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<BaseLayout
  title="Partner with Sauté Sundays"
  description="35 Toronto home cooks, every month, all of them cooking. Product, sponsorship and community partnerships with Toronto's cookbook club."
  canonical="/partners"
  ogImage="/og-partners.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageAlt="Four guests sitting together with their plates at a Sauté Sundays table"
  jsonLd={faqJsonLd}
>
  <div class="mx-auto max-w-[680px] px-5 py-12 sm:py-16">
    <section>
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Sauté Sundays</div>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-[1.08] sm:text-5xl">
        Put your product in a room full of people who cook
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        Each month, around 35 cookbook lovers cook from the same book, bring a dish to Jrew's, and share everything.
        Your product can be served during dinner, handed to attendees to take home, or distributed before the event when
        it genuinely fits the cookbook.
      </p>
      <a
        href="#form"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
      >
        Talk to us
        <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </section>

    <figure class="mt-10 overflow-hidden rounded-lg bg-muted">
      <Image
        src={heroPhoto}
        alt="Four guests sitting together with their plates at Sauté Sundays, the room busy behind them"
        class="h-full w-full object-cover"
        widths={[400, 680, 1000]}
        sizes="(min-width: 720px) 640px, calc(100vw - 40px)"
        format="webp"
        quality={66}
        loading="eager"
      />
    </figure>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">The room</h2>
      <dl class="mt-6 grid grid-cols-2 gap-3">
        {
          stats.map((stat) => (
            <div class="flex flex-col justify-between rounded-lg border border-border bg-muted/40 px-4 py-5">
              <dt class="text-xs uppercase tracking-wider text-muted-foreground">{stat.label}</dt>
              <dd class="mt-2 font-serif text-2xl font-semibold sm:text-3xl">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        Our newsletter is food writing: recipes, food thoughts, club updates, and recaps from previous events. Across
        our seven most recent editorial newsletters, excluding early-access ticket emails, the median open rate was 64%.
        The latest went to 414 people and recorded a 63% open rate and a 5% click rate.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Members regularly tell us they bought the featured cookbook after attending, or share stories about tracking
        down ingredients they had never used before. We keep the room capped so Tammy and Mady can know the people who
        come and hear those stories directly.
      </p>
      <figure class="mt-8 border-l-2 border-primary pl-5">
        <blockquote class="font-serif text-xl leading-relaxed">
          I am so grateful to have found this and left inspired by all the talented chefs! Thank you for organizing.
        </blockquote>
        <figcaption class="mt-3 text-sm text-muted-foreground">Meghna, March 2026</figcaption>
      </figure>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Who we've worked with</h2>
      <div class="mt-6">
        <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Product partners</h3>
        <div class="mt-3 border-l-2 border-primary/40 pl-4">
          <p class="font-serif text-lg font-semibold">Sunny Daze</p>
          <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
            In June 2026, Sunny Daze supplied 30 lemonades for the room. Two team members joined as guests, brought
            dishes, and gave a short introduction. We featured the partnership in one newsletter section, one Instagram
            feed post, and one story. The lemonade stayed available throughout the evening and appeared naturally in the
            event photographs.
          </p>
        </div>
      </div>
      <div class="mt-8">
        <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Community and venue partners</h3>
        <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground">
          <li class="border-l-2 border-border pl-3">Jrew's, our home on Niagara St</li>
          <li class="border-l-2 border-border pl-3">Danu Social House</li>
        </ul>
      </div>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Why this stays free</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        The monthly potluck is free for members. Product and cash partnerships help cover the practical costs of keeping
        it that way.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Ways to partner</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        Most partnerships begin with product. A named month adds visibility across the full event cycle and costs $350
        CAD plus product.
      </p>
      <div class="mt-6 space-y-4">
        {
          ways.map((way, index) => (
            <div
              class:list={[
                "rounded-lg p-5",
                way.badge ? "border-2 border-primary bg-primary/5" : "border border-border bg-muted/30",
              ]}
            >
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <h3 class="font-serif text-lg font-semibold">
                  {index + 1}. {way.title}
                </h3>
                {way.badge && (
                  <span class="rounded-full bg-primary px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-wider text-primary-foreground">
                    {way.badge}
                  </span>
                )}
              </div>
              <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{way.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[620px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-border">
              <th class="py-3 pr-4 align-bottom font-medium">Included</th>
              <th class="py-3 pr-4 align-bottom font-medium">Product for the room</th>
              <th class="py-3 pr-4 align-bottom font-medium">Product to take home</th>
              <th class="py-3 align-bottom font-medium">A month of your own</th>
            </tr>
          </thead>
          <tbody>
            {
              deliverables.map(([label, a, b, c]) => (
                <tr class="border-b border-border/60 align-top">
                  <th scope="row" class="py-3 pr-4 font-medium">{label}</th>
                  <td class="py-3 pr-4 text-muted-foreground">{a}</td>
                  <td class="py-3 pr-4 text-muted-foreground">{b}</td>
                  <td class="py-3 text-muted-foreground">{c}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="mt-10">
        <h3 class="font-serif text-lg font-semibold">Support the room</h3>
        <p class="mt-2 leading-relaxed text-muted-foreground">
          We also work with brands that want to support practical costs such as plates, permits, printing, and the
          website. These partnerships are shaped and priced case by case.
        </p>
      </div>

      <div class="mt-10">
        <h3 class="font-serif text-lg font-semibold">Pre-event product use</h3>
        <p class="mt-2 leading-relaxed text-muted-foreground">
          Some products are best experienced in the cooking itself. When a product naturally suits the featured
          cookbook, we can arrange earlier distribution to interested members who want to try it before the event.
        </p>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          The number of participants, collection plan, and lead time are agreed case by case. Product use remains
          optional, and we report what actually happened afterwards.
        </p>
      </div>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">How it works</h2>
      <dl class="mt-6 space-y-4 text-sm leading-relaxed">
        {
          howItWorks.map((item) => (
            <div class="border-l-2 border-border pl-3">
              <dt class="font-medium text-foreground">{item.term}</dt>
              <dd class="mt-1 text-muted-foreground">{item.detail}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 text-sm leading-relaxed text-muted-foreground">
        Cancellation, attendance, product handling, and full image-use terms are covered in a separate Partnership Terms
        document and shared when the partnership moves forward.
      </p>
      <figure class="mt-8 border-l-2 border-primary pl-5">
        <blockquote class="font-serif text-xl leading-relaxed">
          Love learning about cultures this way, thanks ladies for organizing.
        </blockquote>
        <figcaption class="mt-3 text-sm text-muted-foreground">Thanuja, July 2026</figcaption>
      </figure>
    </section>

    <figure class="mt-10 overflow-hidden rounded-lg bg-muted">
      <Image
        src={roomPhoto}
        alt="A guest holding a full plate above a tray of arroz con pollo at the Sauté Sundays table"
        class="h-full w-full object-cover"
        widths={[400, 680, 1000]}
        sizes="(min-width: 720px) 640px, calc(100vw - 40px)"
        format="webp"
        quality={66}
        loading="lazy"
      />
    </figure>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">What happens afterwards</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        Within seven days, every partner receives the final headcount and 5 to 10 selected photographs from the event.
        We complete the newsletter and Instagram coverage included in the agreed package.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        When feedback has been arranged in advance, we ask one short, voluntary question in our WhatsApp community and
        share an anonymous summary.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Some members post their dishes or product experience and tag us. We reshare relevant posts when they appear.
        Member-created content is always voluntary.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Questions brands ask</h2>
      <div class="mt-4 divide-y divide-border">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-lg font-semibold leading-snug marker:content-none hover:text-primary">
                {faq.question}
                <span class="shrink-0 text-muted-foreground transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-muted-foreground">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section id="form" class="mt-16 scroll-mt-24">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Fifteen minutes is enough to see whether it fits</h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Tell us what you are working on, which product you want people to experience, and roughly when you want to do
        it. We will share the available months and cookbooks and recommend the format that suits the product best.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        The core deliverables are clear, and the activation can be adjusted to suit the product.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">We reply within two days.</p>
      <div class="mt-6 rounded-lg bg-[#f2eeeb] p-4 dark:bg-[#f2eeeb] sm:p-6">
        <iframe
          src="https://tally.so/embed/4405o5?alignLeft=1&hideTitle=1&transparentBackground=1"
          width="100%"
          height="600"
          class="block h-[760px] w-full sm:h-[600px]"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          loading="lazy"
          title="Brand partnership enquiry form"></iframe>
      </div>
      <p class="mt-3 text-center text-sm text-muted-foreground">
        Form not loading? <a href="https://tally.so/r/4405o5" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Open it in a new tab &#8599;</a>
        or email <a href={`mailto:${CONTACT.email}`} class="text-primary hover:underline">{CONTACT.email}</a>.
      </p>
    </section>

    <p class="mt-14 text-center text-sm text-muted-foreground">
      Run a restaurant? <a href="/restaurant-nights" class="text-primary hover:underline">We do hands-on nights &rarr;</a>
    </p>
  </div>
</BaseLayout>
