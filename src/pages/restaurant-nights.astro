---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { REACH, CONTACT } from "../config/theme.config.ts";
import { sortedPosts } from "../lib/blog-data.js";
import heroPhoto from "../assets/gallery/023636E4-7D7E-477F-9FF7-7B1AA2B47916.JPG";
import kitchenPhoto from "../assets/gallery/IMG_8506.jpg";

// One recap per night, so the count of them is the count of nights.
const posts = await sortedPosts();
const nightsRun = posts.filter((post) => post.category === "event-recap").length;

// Feeds dateModified in the page schema. The visible "terms updated" line is
// gone: the confirmation note at the foot of the page says the same thing
// without going stale.
const termsUpdated = "2026-08-28";

// Proof from the free club, kept separate from proof for the paid format.
const stats = [
  { label: "Cookbook-club events sold out", value: `${nightsRun}/${nightsRun}` },
  { label: "Every event sold out within three days", value: REACH.sellsOutIn },
  { label: "Unique members have attended at least twice", value: REACH.repeatMembers },
  { label: "Median open rate across seven recent editorial newsletters", value: REACH.openRateMedian },
];

const formats = [
  {
    title: "Technique workshop",
    body: [
      "One focused dish or technique. Guests make the hands-on component, eat what they make, and may leave with a take-home element.",
      "This is the shorter, lighter format and works well for dumplings, patties, pasta shapes, breads, sauces, shaping, folding, and finishing techniques.",
    ],
  },
  {
    title: "Workshop with a meal",
    body: [
      "The restaurant teaches one dish, then serves it with an additional plate, side, or course.",
      "This suits a technique that is interesting to learn but would not make a complete evening on its own. It needs more kitchen and service time, so the ticket price is normally higher.",
    ],
  },
];

const runOfNight = [
  {
    term: "Set-up",
    detail:
      "Tammy and Mady arrive early, set out name tags and approved recipe or technique cards, check the three table stations, and review the evening with the restaurant.",
  },
  {
    term: "Guest arrival",
    detail: "We check everyone in. Drinks are ordered and paid for directly through the restaurant.",
  },
  {
    term: "Introduction and demonstration",
    detail:
      "The restaurant introduces the dish, the technique, and the people behind it. The demonstration normally takes 15 to 20 minutes.",
  },
  {
    term: "Hands-on workshop",
    detail:
      "Guests work in three small groups at dining-room tables. The restaurant teaches the food; Sauté Sundays manages timing, questions, and guest flow.",
  },
  {
    term: "Cooking and eating",
    detail:
      "Restaurant staff finish anything that requires the kitchen, oven, pass, or heat. Guests then sit down to the agreed food.",
  },
  {
    term: "Close",
    detail:
      "Guests leave with any agreed recipe, technique notes, or take-home component. The restaurant and Sauté Sundays complete the cleanup responsibilities agreed before the event.",
  },
];

const restaurantBrings = [
  "A quiet date and the agreed use of the dining room",
  "A lead cook, chef, or owner who can teach the dish",
  "Ingredient ordering, weighing, portioning, and advance food preparation",
  "Restaurant staff for the kitchen or pass, heat, bar, service, dishwashing, sanitation, and room reset as required",
  "Three table workstations and the agreed equipment",
  "Ingredient, allergen, storage, cooking, and take-home instructions",
  "Confirmation that the proposed activity works for the premises, insurer, and food-safety setup before tickets go live",
];

const weBring = [
  "Fifteen ticketed guests drawn first from our community",
  "Promotion through the agreed newsletter, Instagram, WhatsApp, event listing, and recap",
  "Ticketing, payment collection, attendee communication, and check-in",
  "A sales checkpoint fourteen days before the event",
  "Final paid headcount and dietary information ten days before the event",
  "Name tags and restaurant-approved recipe or technique cards",
  "Tammy and Mady on site to host, manage timing, and support the groups",
  "Five to ten selected documentary photographs, plus final ticket and attendance numbers after the event",
];

const payouts = [
  ["$40 CAD", "Approximately $393 to the restaurant", "Approximately $503 to the restaurant"],
  ["$50 CAD", "Approximately $504 to the restaurant", "Approximately $641 to the restaurant"],
];

const timeline = [
  ["6 to 8 weeks before", "We visit the space and agree on the dish, guest tasks, format, working ticket price, date, and preliminary staffing."],
  ["5 to 6 weeks before", "Both sides approve the Restaurant Night Confirmation and Terms. Insurance and food-safety requirements are confirmed."],
  ["4 weeks before", "Tickets go live after the pre-launch conditions are complete."],
  ["14 days before", "We review paid sales against the agreed minimum ticket number and minimum restaurant payout."],
  ["10 days before", "We send the final paid headcount and dietary information. The first restaurant payment is made according to the agreement."],
  ["3 to 5 days before", "We confirm the final event checklist: preparation, stations, equipment, staff, service, take-home items, cleanup, and emergency contacts."],
  ["Event day", "The workshop takes place. The final restaurant payment follows the agreed schedule."],
  ["Within 7 days afterwards", "We send selected photographs, final ticket and attendance figures, and the agreed follow-up coverage."],
];

const beforeLaunch = [
  {
    term: "Economics",
    detail:
      "We agree on the ticket price, capacity, minimum paid-ticket number, minimum restaurant payout, tax treatment, and payment schedule.",
  },
  {
    term: "Food safety",
    detail:
      "We agree on the exact guest tasks, handwashing, sanitation, ingredient handling, temperature control, take-home food, and use of the dining room. The setup is confirmed with Toronto Public Health where needed.",
  },
  {
    term: "Insurance",
    detail:
      "The restaurant confirms the proposed activity with its insurer or broker. If the format requires separate event insurance, organizer coverage, a waiver, or additional-insured status, we agree in writing who arranges it and who pays before tickets are released.",
  },
  {
    term: "Allergies and dietary requirements",
    detail:
      "Sauté Sundays collects dietary and allergy information during registration. The restaurant confirms which requests it can safely accommodate and provides the ingredient and cross-contact information used in guest communication. We do not describe the workshop as allergen-free unless the restaurant expressly offers that environment.",
  },
  {
    term: "Recipe and restaurant brand",
    detail:
      "The restaurant chooses whether guests receive a full recipe, a simplified home version, technique notes, or no recipe. It approves the dish name, wording, logo, ingredient information, and any proprietary method before publication or printing.",
  },
  {
    term: "Room and labour",
    detail:
      "We agree on staff, advance preparation, equipment, table layout, kitchen and pass support, bar operation, dishwashing, sanitation, cleanup, breakage, room reset, and whether the restaurant remains open to walk-ins.",
  },
];

const promotion = [
  "One announcement in the Sauté Sundays editorial newsletter",
  "A ticket page naming the restaurant and dish",
  "One Instagram feed or collaborative post",
  "Launch, reminder, and event-night Instagram stories",
  "One announcement in the Sauté Sundays WhatsApp community",
  "A post-event website or newsletter recap naming the restaurant",
  "Five to ten selected documentary photographs delivered within seven days",
  "Final paid-ticket and attendance figures",
  "An optional anonymous guest-feedback summary when agreed in advance",
];

const faqs = [
  {
    question: "Have you run this format before?",
    answer:
      "Restaurant Nights is a new paid format. Our thirteen sold-out cookbook-club events show that we can build, communicate with, and host the community. For each restaurant's first workshop, we use a small pilot, a minimum-sales checkpoint, and a written agreement before tickets go live.",
  },
  {
    question: "What kind of night should we offer you?",
    answer:
      "A night that is already quiet for the restaurant. We visit the room, discuss what your kitchen could teach, and build the workshop around the dish, space, staffing, and service you already have.",
  },
  {
    question: "How many people, exactly?",
    answer:
      "Fifteen ticketed guests. Tammy and Mady attend as hosts, so the restaurant prepares seventeen food portions at full capacity. We will not increase the guest capacity without the restaurant's written approval.",
  },
  {
    question: "Does anyone enter the kitchen?",
    answer:
      "The default is no. Guests work at dining-room tables. Restaurant staff control the kitchen, pass, oven, heat, and final cooking. Any guest kitchen access or additional task must be specifically approved in the event agreement, food-safety plan, and insurance confirmation.",
  },
  {
    question: "Does it have to be a full meal?",
    answer:
      "No. A technique workshop focuses on one dish or skill. A workshop with a meal adds a side, plate, or course when the taught dish would not make a complete evening on its own. The format and ticket price are built around the food and labour each version requires.",
  },
  {
    question: "What if the owner is the one teaching?",
    answer:
      "That can work well. The restaurant should include the owner's preparation, teaching, service, and closing time when deciding the minimum payment it needs for the night. We also agree in advance whether the restaurant can remain open to regular customers during the workshop.",
  },
  {
    question: "What if ticket sales are slow?",
    answer:
      "Fourteen days before the event, we compare paid sales with the agreed minimum ticket number and minimum restaurant payment. If either minimum has not been reached, the restaurant can choose to proceed, reschedule, or release the date.",
  },
  {
    question: "When do we get paid?",
    answer:
      "Our standard arrangement is 50% of the projected restaurant payment ten days before the event, followed by the remaining balance within one business day afterwards. The final amount is based on paid and non-refunded tickets and the actual transaction fees. A different schedule can be recorded in the event-specific agreement.",
  },
  {
    question: "What if ticket holders cancel or do not attend?",
    answer:
      "Each event has a written refund and transfer policy on the ticket page. The restaurant payment is calculated from paid, non-refunded tickets. A no-show after the refund deadline does not reduce the restaurant payment.",
  },
  {
    question: "What about the bar?",
    answer:
      "Guests order and pay for drinks directly through the restaurant. The restaurant keeps all bar revenue and tips. Drinks are not included in the ticket unless we agree otherwise, and Sauté Sundays does not promise a minimum beverage spend.",
  },
  {
    question: "How are insurance, food safety, and licensing handled?",
    answer:
      "Before tickets go live, the restaurant confirms the specific workshop activity with its insurer or broker. We also agree on the food-safety setup and contact Toronto Public Health where needed. The restaurant retains control of its premises, kitchen, food handling, alcohol service, staff, and licences. Any additional insurance cost or requirement is agreed before the event is launched.",
  },
  {
    question: "How are allergies and dietary requirements handled?",
    answer:
      "We collect the information during registration and send the final list to the restaurant ten days before the event. The restaurant confirms which requests it can safely accommodate. Guests remain responsible for providing complete information, and the event is not described as allergen-free unless the restaurant expressly confirms that.",
  },
  {
    question: "Can guests bring their own filling or ingredient?",
    answer:
      "Only when the restaurant wants that format and the food-safety and insurance review supports it. The ticket page must state exactly what may be brought, how it should be prepared, labelled, transported, and checked at arrival, whether it may be shared, and what happens when an item cannot be accepted.",
  },
  {
    question: "Are these experienced cooks?",
    answer:
      "Most are confident, curious home cooks who voluntarily cook from a cookbook each month. The workshops are designed for people who are comfortable following a recipe. We still choose the guest tasks carefully and do not assume professional kitchen experience.",
  },
  {
    question: "Who controls the recipe or take-home instructions?",
    answer:
      "The restaurant does. It chooses whether guests receive a full recipe, a simplified home version, technique notes, or no recipe. The restaurant approves the final dish name, recipe wording, dietary information, and logo use before anything is printed or published.",
  },
  {
    question: "What does Sauté Sundays keep?",
    answer:
      "We keep a flat $45 per workshop for printing and administration. Actual platform and payment-processing fees are deducted separately. The remaining ticket proceeds go to the restaurant.",
  },
  {
    question: "How far ahead do we need to decide?",
    answer:
      "Six to eight weeks is the usual lead time. That gives us time to visit the room, agree the economics and format, complete the insurance and food-safety checks, approve the ticket copy, and promote the event properly.",
  },
];

// The questions are on the page, so they can be marked up. Built from the same
// array the page renders, so the two cannot drift.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  dateModified: termsUpdated,
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<BaseLayout
  title="Restaurant nights - Sauté Sundays"
  description="We bring fifteen ticketed guests into your restaurant on a quiet night. Your team teaches one dish at dining-room tables, and the ticket proceeds go to you."
  canonical="/restaurant-nights"
  ogImage="/og-restaurant-nights.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageAlt="Guests filling their plates from shared trays at a Sauté Sundays table"
  jsonLd={faqJsonLd}
>
  <div class="mx-auto max-w-[680px] px-5 py-12 sm:py-16">
    <section>
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Sauté Sundays</div>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-[1.08] sm:text-5xl">
        Fill a quiet night with people who came for the food
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        We bring fifteen ticketed guests from our cookbook community into your restaurant on a night that is already
        quiet. Your team teaches one dish. Guests handle the agreed hands-on steps at dining-room tables, while your
        staff retain control of the kitchen, heat, and final cooking.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        Tammy and Mady are there too, hosting the evening and working alongside the group.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        The restaurant does not pay Sauté Sundays a venue or marketing fee. Guests buy tickets through us. After actual
        ticketing and payment-processing fees, Sauté Sundays keeps a flat $45 for printing and administration, and the
        remaining ticket proceeds go to the restaurant.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">All bar revenue and tips stay with you.</p>
      <p class="mt-6 border-l-2 border-primary pl-4 font-medium">
        15 ticketed guests + Tammy and Mady = 17 food portions at full capacity.
      </p>
      <a
        href="#form"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
      >
        Start a conversation
        <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </section>

    <figure class="mt-10 overflow-hidden rounded-lg bg-muted">
      <Image
        src={heroPhoto}
        alt="A busy Sauté Sundays table, guests serving themselves from trays and glass dishes while others reach across"
        class="h-full w-full object-cover"
        widths={[400, 680, 1000]}
        sizes="(min-width: 720px) 640px, calc(100vw - 40px)"
        format="webp"
        quality={66}
        loading="eager"
      />
    </figure>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Who we'd bring</h2>
      <dl class="mt-6 grid grid-cols-2 gap-3">
        {
          stats.map((stat) => (
            <div class="flex flex-col justify-between rounded-lg border border-border bg-muted/40 px-4 py-5">
              <dt class="text-xs uppercase tracking-wider text-muted-foreground">{stat.label}</dt>
              <dd class="mt-2 font-serif text-2xl font-semibold sm:text-3xl">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        These figures come from our free monthly cookbook club. At Jrew's, we now release 35 member places each month.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Our latest editorial newsletter went to 414 people and recorded a 63% open rate and a 5% click rate.
        Early-access ticket emails are excluded from the newsletter benchmark.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        The results show that we can build, communicate with, and host an engaged food community. The paid restaurant
        workshop is a newer format, so we use a controlled first-night pilot and a sales checkpoint before the restaurant
        commits its full food and staffing costs.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">A controlled first night</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        A restaurant's first workshop with us is treated as a pilot. Before tickets go live, we agree on the ticket
        price, the minimum number of paid guests, and the minimum total payment the restaurant needs for the night to
        proceed.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Fourteen days before the event, we compare actual paid sales with that minimum. The restaurant can proceed, move
        the workshop to another date, or release the night if the agreed threshold has not been reached.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Two ways to build the workshop</h2>
      <div class="mt-6 space-y-4">
        {
          formats.map((format) => (
            <div class="rounded-lg border border-border bg-muted/30 p-5">
              <h3 class="font-serif text-lg font-semibold">{format.title}</h3>
              {format.body.map((line) => (
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{line}</p>
              ))}
            </div>
          ))
        }
      </div>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        The restaurant decides what guests are allowed to handle. For a first workshop, we favour table work such as
        shaping, folding, mixing, assembling, or finishing. Raw-protein handling and heat remain with restaurant staff
        unless the specific activity has been approved before tickets go live.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground/80">
        Guest-supplied fillings or ingredients are offered only as a separately agreed ticket option, with written rules
        for ingredients, allergens, transport, storage, check-in, sharing, and what happens when an item cannot be
        accepted.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">How the night runs</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        A typical workshop takes about three hours. The exact timing depends on the dish.
      </p>
      <dl class="mt-6 space-y-4 text-sm leading-relaxed">
        {
          runOfNight.map((item) => (
            <div class="border-l-2 border-border pl-3">
              <dt class="font-medium text-foreground">{item.term}</dt>
              <dd class="mt-1 text-muted-foreground">{item.detail}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        Most attendees are confident, curious home cooks who voluntarily cook from a cookbook each month. The workshop
        is designed for people who are comfortable following a recipe, rather than complete beginners learning basic
        knife grip.
      </p>
      <figure class="mt-8 border-l-2 border-primary pl-5">
        <blockquote class="font-serif text-xl leading-relaxed">Everyone is such a good cook 🥰</blockquote>
        <figcaption class="mt-3 text-sm text-muted-foreground">Leena, February 2026</figcaption>
      </figure>
    </section>

    <figure class="mt-10 overflow-hidden rounded-lg bg-muted">
      <Image
        src={kitchenPhoto}
        alt="Guests helping themselves along a counter at Sauté Sundays, dishes and serving spoons spread the length of it"
        class="h-full w-full object-cover"
        widths={[400, 680, 1000]}
        sizes="(min-width: 720px) 640px, calc(100vw - 40px)"
        format="webp"
        quality={66}
        loading="lazy"
      />
    </figure>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">What each side brings</h2>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        <div>
          <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">The restaurant</h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground">
            {restaurantBrings.map((item) => <li class="border-l-2 border-border pl-3">{item}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Sauté Sundays</h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground">
            {weBring.map((item) => <li class="border-l-2 border-primary/40 pl-3">{item}</li>)}
          </ul>
        </div>
      </div>
      <p class="mt-6 text-sm leading-relaxed text-muted-foreground">
        Setup, dishwashing, waste, table sanitation, room reset, breakage, and closing responsibilities are recorded
        before the event so neither side discovers them on the night.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">How the money works</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        The restaurant does not pay Sauté Sundays a venue or marketing fee.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        We propose a public ticket price and show you what the restaurant payment looks like at the minimum sales
        threshold and at full capacity. Before tickets go live, you approve both the ticket price and the minimum total
        payment at which you are willing to run the night.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Actual ticketing and payment-processing fees are deducted first. Sauté Sundays keeps a flat $45 for printing and
        administration. The remaining proceeds go to the restaurant.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">All bar revenue and tips stay with the restaurant.</p>

      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[520px] border-collapse text-left text-sm">
          <thead>
            <tr class="border-b border-border">
              <th class="py-3 pr-4 align-bottom font-medium">Working ticket price</th>
              <th class="py-3 pr-4 align-bottom font-medium">12 paid guests / 14 food portions</th>
              <th class="py-3 align-bottom font-medium">15 paid guests / 17 food portions</th>
            </tr>
          </thead>
          <tbody>
            {
              payouts.map(([price, low, high]) => (
                <tr class="border-b border-border/60 align-top">
                  <th scope="row" class="py-3 pr-4 font-medium">{price}</th>
                  <td class="py-3 pr-4 text-muted-foreground">{low}</td>
                  <td class="py-3 text-muted-foreground">{high}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground">
        These figures are examples. The final restaurant payment is calculated from the actual event transaction report
        after refunds, chargebacks, platform fees, processing fees, and the flat $45 Sauté Sundays amount. Applicable tax
        treatment is agreed in writing before tickets go live.
      </p>

      <div class="mt-10">
        <h3 class="font-serif text-lg font-semibold">The sales checkpoint</h3>
        <p class="mt-2 leading-relaxed text-muted-foreground">
          A standard starting point is twelve paid tickets, reviewed fourteen days before the event. The restaurant also
          approves a minimum total payment for the selected workshop.
        </p>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          If either minimum has not been reached, the restaurant can choose to proceed, move the workshop to another
          date, or release the night. Sauté Sundays does not automatically cover a shortfall.
        </p>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          Once the event is proceeding, our standard payment schedule is 50% of the projected restaurant payment ten
          days before, based on paid and non-refunded tickets at that point, and the remaining balance within one
          business day afterwards, calculated from paid and non-refunded tickets and the actual transaction fees.
        </p>
        <p class="mt-4 leading-relaxed text-muted-foreground">
          A ticket-holder no-show after the event's refund deadline does not reduce the restaurant payment.
        </p>
      </div>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">From interest to the night</h2>
      <dl class="mt-6 space-y-4 text-sm leading-relaxed">
        {
          timeline.map(([when, what]) => (
            <div class="border-l-2 border-primary/40 pl-3">
              <dt class="font-medium text-foreground">{when}</dt>
              <dd class="mt-1 text-muted-foreground">{what}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Before tickets go live</h2>
      <dl class="mt-6 space-y-4 text-sm leading-relaxed">
        {
          beforeLaunch.map((item) => (
            <div class="border-l-2 border-border pl-3">
              <dt class="font-medium text-foreground">{item.term}</dt>
              <dd class="mt-1 text-muted-foreground">{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <figure class="mt-14 border-l-2 border-primary pl-5">
      <blockquote class="font-serif text-xl leading-relaxed">
        Thanks to Tammy et al for organizing a great event. The time flew by, and the food and company were stellar.
      </blockquote>
      <figcaption class="mt-3 text-sm text-muted-foreground">Karen, March 2026</figcaption>
    </figure>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Promotion and follow-up</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        The exact plan is confirmed for each workshop. A typical collaboration includes:
      </p>
      <ul class="mt-6 space-y-3 text-sm leading-relaxed text-muted-foreground">
        {promotion.map((item) => <li class="border-l-2 border-primary/40 pl-3">{item}</li>)}
      </ul>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        Member posts, recommendations, bar spending, sales, and repeat visits can happen naturally around the event. The
        Restaurant Night Confirmation lists the promotional placements Sauté Sundays commits to delivering.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Questions restaurants ask</h2>
      <div class="mt-4 divide-y divide-border">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-lg font-semibold leading-snug marker:content-none hover:text-primary">
                {faq.question}
                <span class="shrink-0 text-muted-foreground transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-muted-foreground">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section id="form" class="mt-16 scroll-mt-24">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">The next step is half an hour in your room</h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        We look at the space, discuss what you would want to teach, and build a simple projection for the minimum and
        full night.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        We will also identify the guest tasks, restaurant staffing, equipment, food-safety setup, and any insurance
        questions that need to be resolved.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        If the economics, workload, or format do not make sense, we will say so before either side commits.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">We reply within two days.</p>
      <div class="mt-6 rounded-lg bg-[#f2eeeb] p-4 dark:bg-[#f2eeeb] sm:p-6">
        <iframe
          src="https://tally.so/embed/LZxlJJ?alignLeft=1&hideTitle=1&transparentBackground=1"
          width="100%"
          height="600"
          class="block h-[820px] w-full sm:h-[640px]"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          loading="lazy"
          title="Restaurant nights enquiry form"></iframe>
      </div>
      <p class="mt-3 text-center text-sm text-muted-foreground">
        Form not loading? <a href="https://tally.so/r/LZxlJJ" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Open it in a new tab &#8599;</a>
        or email <a href={`mailto:${CONTACT.email}`} class="text-primary hover:underline">{CONTACT.email}</a>.
      </p>
      <p class="mt-6 border-l-2 border-border pl-4 text-sm leading-relaxed text-muted-foreground">
        This page describes our standard Restaurant Night model. A workshop is confirmed only when both sides approve
        the event-specific Restaurant Night Confirmation and Terms and the required pre-launch checks are complete.
      </p>
    </section>

    <p class="mt-14 text-center text-sm text-muted-foreground">
      Not a restaurant? <a href="/partners" class="text-primary hover:underline">We work with brands too &rarr;</a>
    </p>
  </div>
</BaseLayout>
