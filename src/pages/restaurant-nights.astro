---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import { REACH, CONTACT } from "../config/theme.config.ts";
import heroPhoto from "../assets/gallery/023636E4-7D7E-477F-9FF7-7B1AA2B47916.JPG";
import kitchenPhoto from "../assets/gallery/IMG_8506.jpg";

const stats = [
  { label: "Sells out in", value: REACH.sellsOutIn },
  { label: "Repeat members", value: REACH.repeatMembers },
  { label: "Subscribers", value: REACH.subscribers },
  { label: "Newsletter opens", value: REACH.openRate },
];

const youBring = [
  "A night you're open and quiet",
  "Someone to lead the dish",
  "Ingredients for the agreed headcount",
  "Space for three small groups, plus sink and oven access",
  "Whatever food you're serving alongside",
];

const weBring = [
  "The guests, from our own community",
  "All promotion: newsletter, Instagram, WhatsApp",
  "Ticketing, sign-ups and payment handling",
  "Headcount, dietary flags and allergy notes in advance",
  "Both of us on site for the evening",
];

const openQuestions = [
  {
    term: "Insurance",
    detail:
      "Whether your policy covers non-staff in the kitchen, or whether we take out event coverage. We're happy to arrange that.",
  },
  {
    term: "Public Health",
    detail: "You hold the licence, so we'd follow your lead on what your inspector is comfortable with.",
  },
  { term: "The space", detail: "We'd like to visit before agreeing anything." },
  {
    term: "Your room",
    detail:
      "Fifteen people in three groups. If you're the one teaching, you probably can't run normal service at the same time. Worth deciding early whether you're closed to walk-ins that night.",
  },
  {
    term: "The dish",
    detail: "Which one, who's leading it, and whether you're happy for guests to take the recipe home.",
  },
  { term: "Drinks", detail: "During the cooking or after." },
  { term: "Cleanup and leftovers", detail: "Who handles what." },
];

const afterwards = [
  "A written recap on our site with photographs, naming you",
  "Coverage in our newsletter and on Instagram, before and after",
  "Fifteen people who spent three hours in your kitchen and will tell people where they went",
];

const faqs = [
  {
    question: "What kind of night should we offer you?",
    answer:
      "A night you're already open and quiet. We're not after your Friday. Tell us what's slow and we'll build around it.",
  },
  {
    question: "How many people, exactly?",
    answer:
      "Fifteen. We won't send more without asking. If we end up under ten, we'll check with you rather than assume.",
  },
  {
    question: "Does it have to be a full meal?",
    answer:
      "No, and we run both. Some nights are technique only: one dish, everyone makes it, everyone eats what they made, nothing else served. Others teach a dish and serve a meal alongside it. Tell us which suits your kitchen and we price it accordingly.",
  },
  {
    question: "What if the owner is the one teaching?",
    answer:
      "Most of the places we want to work with, that's exactly who it'd be. Just factor your own hour into the number you quote us, and think about whether you can run service at the same time.",
  },
  {
    question: "When do we get paid?",
    answer:
      "Headcount is confirmed 10 days out. We can send half then if you need it for ingredients, with the balance on the night, or all of it on the night. Your call.",
  },
  {
    question: "What if people cancel?",
    answer:
      "Tickets are non-refundable and non-transferable, so a late cancellation doesn't change what you're paid.",
  },
  {
    question: "What about the bar?",
    answer: "Entirely yours. We don't take a cut and we don't bundle drinks into the ticket. Our members drink.",
  },
  {
    question: "Do you need our liquor licence or food handling certification?",
    answer:
      "You hold both, and we follow your lead. If your insurer needs event coverage for non-staff in the kitchen, we'll arrange it.",
  },
  {
    question: "Are these experienced cooks?",
    answer:
      "Home cooks who choose to spend a Sunday cooking from a cookbook. Confident, curious, and not squeamish.",
  },
  {
    question: "What do you get out of this?",
    answer:
      "A flat $45 a night for printing and admin. The rest of the ticket is yours, minus about 8% that Luma and Stripe take for processing. Our monthly club is free and stays free. This is a separate thing we run alongside it.",
  },
  {
    question: "How far ahead do we need to decide?",
    answer: "About four weeks to confirm. We'd want to see the space before that.",
  },
];

// The questions are on the page, so they can be marked up. Built from the same
// array the page renders, so the two cannot drift.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};
---

<BaseLayout
  title="Restaurant nights - Sauté Sundays"
  description="We bring 15 home cooks into your restaurant on a quiet night. You teach them one dish, they cook it, then they stay and eat. You're paid per head and the bar is yours."
  canonical="/restaurant-nights"
  ogImage="/og-restaurant-nights.jpg"
  ogImageWidth={1200}
  ogImageHeight={630}
  ogImageAlt="Guests filling their plates from shared trays at a Sauté Sundays table"
  jsonLd={faqJsonLd}
>
  <div class="mx-auto max-w-[680px] px-5 py-12 sm:py-16">
    <section>
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">Sauté Sundays</div>
      <h1 class="mt-3 font-serif text-4xl font-semibold leading-[1.08] sm:text-5xl">
        Fill a quiet night with people who came for the food
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-muted-foreground">
        We bring 15 of our members into your room. You teach them one dish. They cook it, then stay and eat and drink.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        You never write us a cheque. You're paid per head from ticket sales, and the bar is yours.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        We're not asking for your busiest night. Tell us which night is quiet and we'll build around it.
      </p>
      <a
        href="#form"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
      >
        Start a conversation
        <Icon name="arrow-right" class="h-3.5 w-3.5" />
      </a>
    </section>

    <figure class="mt-10 overflow-hidden rounded-lg bg-muted">
      <Image
        src={heroPhoto}
        alt="A busy Sauté Sundays table, guests serving themselves from trays and glass dishes while others reach across"
        class="h-full w-full object-cover"
        widths={[400, 680, 1000]}
        sizes="(min-width: 720px) 640px, calc(100vw - 40px)"
        format="webp"
        quality={66}
        loading="eager"
      />
    </figure>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Who we'd bring</h2>
      <dl class="mt-6 grid grid-cols-2 gap-3">
        {
          stats.map((stat) => (
            <div class="rounded-lg border border-border bg-muted/40 px-4 py-5">
              <dt class="text-xs uppercase tracking-wider text-muted-foreground">{stat.label}</dt>
              <dd class="mt-1 font-serif text-2xl font-semibold sm:text-3xl">{stat.value}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-6 leading-relaxed text-muted-foreground">
        A free monthly cookbook club, running since 2025 at Jrew's on Niagara. Everyone who comes cooks. 35 seats, sold
        out every month, and the waitlist gets longer rather than shorter.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">How the night runs</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        Guests arrive and get a drink. Whoever's leading introduces the dish and demonstrates. Everyone cooks in three
        small groups. Then they sit down and eat what they made.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Home cooks, most of them confident, all of them there because they want to be. Nobody's starting from knife
        grip.
      </p>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground/80">
        About three hours. You'd know better than us how long the cooking part takes, and that's one of the first things
        we'd ask you.
      </p>
    </section>

    <figure class="mt-10 overflow-hidden rounded-lg bg-muted">
      <Image
        src={kitchenPhoto}
        alt="Guests helping themselves along a counter at Sauté Sundays, dishes and serving spoons spread the length of it"
        class="h-full w-full object-cover"
        widths={[400, 680, 1000]}
        sizes="(min-width: 720px) 640px, calc(100vw - 40px)"
        format="webp"
        quality={66}
        loading="lazy"
      />
    </figure>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">What each side brings</h2>
      <div class="mt-6 grid gap-8 sm:grid-cols-2">
        <div>
          <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">You</h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground">
            {youBring.map((item) => <li class="border-l-2 border-border pl-3">{item}</li>)}
          </ul>
        </div>
        <div>
          <h3 class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Us</h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-muted-foreground">
            {weBring.map((item) => <li class="border-l-2 border-primary/40 pl-3">{item}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">The money</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        You're paid per head from ticket sales. You never write us a cheque, and the bar is yours.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Most nights work out between $20 and $40 a head for you, depending on what you're teaching. The more technical
        the dish, the more the ticket supports. Our members will pay more to learn something they can't pick up from a
        video.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        We keep $45 flat per night for recipe card printing and admin. Same on every night, whatever the ticket. Luma
        and Stripe take about 8% of the ticket for processing. Everything else is yours.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Two ways this runs. Technique only: one dish, everyone makes it, everyone eats what they made, nothing else
        served. Or with a meal: you teach one dish, then serve alongside it. Tell us which suits your kitchen.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        We confirm headcount 10 days out so you can shop and prep against a real number. If you need money up front for
        ingredients, we'll send half then and the balance on the night. Whatever suits your cash flow.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Tickets are non-refundable and non-transferable, so a late cancellation doesn't change what you're paid.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Two of those covers are us. We run the night and we cook alongside everyone else.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Confirming the date</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        We'd confirm about four weeks ahead and hold ticket sales until then, so an early change costs nobody anything.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Once tickets are live we'll ask that the date is firm. If something unavoidable comes up on either side, we'd
        reschedule rather than cancel, so nobody who bought a ticket loses out. If we've sent a deposit and the night
        can't go ahead, it comes back to us.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        If we're under ten guests two weeks out, we'll come to you. You decide whether to run it or take the night back,
        no hard feelings either way.
      </p>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Things we'd work out with you</h2>
      <p class="mt-5 leading-relaxed text-muted-foreground">
        Nothing here we'd rather discover than tell you on the night.
      </p>
      <dl class="mt-6 space-y-4 text-sm leading-relaxed">
        {
          openQuestions.map((item) => (
            <div class="border-l-2 border-border pl-3">
              <dt class="font-medium text-foreground">{item.term}</dt>
              <dd class="mt-1 text-muted-foreground">{item.detail}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">What you get afterwards</h2>
      <ul class="mt-6 space-y-3 leading-relaxed text-muted-foreground">
        {afterwards.map((item) => <li class="border-l-2 border-primary/40 pl-3">{item}</li>)}
      </ul>
    </section>

    <section class="mt-14">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Questions restaurants ask</h2>
      <div class="mt-4 divide-y divide-border">
        {
          faqs.map((faq) => (
            <details class="group py-5">
              <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-lg font-semibold leading-snug marker:content-none hover:text-primary">
                {faq.question}
                <span class="shrink-0 text-muted-foreground transition-transform group-open:rotate-45">+</span>
              </summary>
              <p class="mt-3 leading-relaxed text-muted-foreground">{faq.answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section id="form" class="mt-16 scroll-mt-24">
      <h2 class="font-serif text-2xl font-semibold sm:text-3xl">Talk to us</h2>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        Our monthly cookbook club is free and always will be. This is a separate thing, for people who want a night in a
        real kitchen.
      </p>
      <p class="mt-4 leading-relaxed text-muted-foreground">
        We reply within two days. Next step is half an hour in your room, no commitments.
      </p>
      <div class="mt-6 rounded-lg bg-[#f2eeeb] p-4 dark:bg-[#f2eeeb] sm:p-6">
        <iframe
          src="https://tally.so/embed/LZxlJJ?alignLeft=1&hideTitle=1&transparentBackground=1"
          width="100%"
          height="600"
          class="block h-[820px] w-full sm:h-[640px]"
          frameborder="0"
          marginheight="0"
          marginwidth="0"
          loading="lazy"
          title="Restaurant nights enquiry form"></iframe>
      </div>
      <p class="mt-3 text-center text-sm text-muted-foreground">
        Form not loading? <a href="https://tally.so/r/LZxlJJ" target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">Open it in a new tab &#8599;</a>
        or email <a href={`mailto:${CONTACT.email}`} class="text-primary hover:underline">{CONTACT.email}</a>.
      </p>
    </section>

    <p class="mt-14 text-center text-sm text-muted-foreground">
      Not a restaurant? <a href="/partners" class="text-primary hover:underline">We work with brands too &rarr;</a>
    </p>
  </div>
</BaseLayout>
