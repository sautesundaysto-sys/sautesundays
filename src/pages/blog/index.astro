---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PostCard from "../../components/PostCard.astro";
import { SITE, categories, sortedPosts } from "../../lib/blog-data.js";

const posts = await sortedPosts();
// Each night has two posts, a recap and a cookbook highlight, so posts.length
// is roughly double the number of events. Count the recaps.
const eventCount = posts.filter((post) => post.category === "event-recap").length;
---

<BaseLayout
  title={`Event Recaps - ${SITE.name}`}
  description="A year of Sauté Sundays in Toronto. Every cookbook we've cooked from, every night at the table, recapped."
  canonical="/blog"
>
  <div class="mx-auto max-w-4xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "Recaps" }]} />

    <header class="mt-4 mb-10">
      <h1 class="font-serif text-4xl font-semibold sm:text-5xl">Every night at the table.</h1>
      <p class="mt-3 max-w-xl text-muted-foreground">
        A year of cookbooks, cuisines, and community, recapped. {eventCount} {eventCount === 1 ? "event" : "events"} and counting.
      </p>
    </header>

    <div class="mb-8 flex flex-wrap gap-2">
      <button
        type="button"
        data-home-filter=""
        class="inline-flex min-h-11 items-center rounded-full border px-4 text-xs transition-colors border-foreground bg-foreground text-background"
      >
        All
      </button>
      {
        categories.map((category) => (
          <button
            type="button"
            data-home-filter={category.slug}
            class="inline-flex min-h-11 items-center rounded-full border px-4 text-xs transition-colors border-border text-muted-foreground hover:text-foreground"
          >
            {category.name}
          </button>
        ))
      }
    </div>

    <div data-home-empty class="mt-12 rounded-md border border-dashed border-border py-20 text-center text-muted-foreground" hidden>
      <p>Nothing here yet in this category.</p>
    </div>

    <div class="space-y-6" data-posts-list>
      {posts.map((post) => (
        <PostCard post={post} variant="list" />
      ))}
    </div>

    <div class="mt-10 text-center">
      <button
        type="button"
        data-show-more
        class="inline-flex min-h-11 items-center gap-2 rounded-full border border-border px-6 text-sm font-medium hover:bg-muted"
        hidden
      >
        Show more
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = [...document.querySelectorAll("[data-home-filter]")];
  const cards = [...document.querySelectorAll("[data-post-card]")];
  const empty = document.querySelector("[data-home-empty]");
  const activeClasses = ["border-foreground", "bg-foreground", "text-background"];
  const inactiveClasses = ["border-border", "text-muted-foreground", "hover:text-foreground"];

  const setActive = (button, active) => {
    button.classList.toggle(activeClasses[0], active);
    button.classList.toggle(activeClasses[1], active);
    button.classList.toggle(activeClasses[2], active);
    inactiveClasses.forEach((c) => button.classList.toggle(c, !active));
  };

  const filter = (category) => {
    let visible = 0;
    cards.forEach((card) => {
      const match = !category || card.dataset.category === category;
      card.hidden = !match;
      if (match) visible++;
    });
    if (empty) empty.hidden = visible > 0;
    buttons.forEach((btn) => setActive(btn, (btn.dataset.homeFilter || "") === category));
  };

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => filter(btn.dataset.homeFilter || ""));
  });

  // Reveal in batches. Without this the phone gets every post at once, which
  // ran to about eighteen screens of scrolling.
  const BATCH = 8;
  const showMore = document.querySelector("[data-show-more]");
  let shown = BATCH;
  let category = "";

  const render = () => {
    let matched = 0;
    cards.forEach((card) => {
      const match = !category || card.dataset.category === category;
      card.hidden = !match || matched >= shown;
      if (match) matched += 1;
    });
    if (empty) empty.hidden = matched > 0;
    if (showMore) {
      showMore.hidden = matched <= shown;
      showMore.textContent = `Show more (${Math.max(matched - shown, 0)} left)`;
    }
  };

  showMore?.addEventListener("click", () => {
    shown += BATCH;
    render();
  });

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      category = btn.dataset.homeFilter || "";
      shown = BATCH;
      render();
    });
  });

  render();
</script>