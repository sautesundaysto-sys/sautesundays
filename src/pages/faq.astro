---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT } from "../config/theme.config.ts";

const faqs = [
  {
    question: "How does it work?",
    answer: "Each month we pick a cookbook. You choose a recipe, make it at home, and bring it to share at our gathering. Everyone signs up for a different dish so the table ends up with a full spread from the same book. No duplicates, lots of variety. You can find the recipe sign-up index on our RSVP page once you register."
  },
  {
    question: "What do I need to bring?",
    answer: "A homemade dish from the featured cookbook, your own plate and cutlery (we try to keep things sustainable), anything needed for safe food transport, a container for leftovers, and an appetite. You're also welcome to bring a drink to share, though it's optional."
  },
  {
    question: "Can I come without cooking?",
    answer: "No. Everyone cooks, and that rule is what makes the room work. The energy comes from everyone arriving with something they made themselves."
  },
  {
    question: "I don't know anyone. Is that weird?",
    answer: "Most people come alone the first time. The dish in your hands is an easy conversation starter, and everyone cooked from the same book, so there's already something to compare notes on."
  },
  {
    question: "Where can I get the recipes?",
    answer: "You don't have to buy the cookbook, though we do encourage supporting the authors if you can. You can also check it out on Libby, borrow from a friend, or browse it at your local bookstore. If you're having trouble accessing the recipes, reach out and we'll help."
  },
  {
    question: "When do I have to pick my recipe?",
    answer: "Sign-ups close 12 hours before the event. You'll get the link in your confirmation email and a reminder before the deadline. If you miss it, your spot goes to someone on the waitlist. With 10+ people waiting every month, we can't hold seats open."
  },
  {
    question: "Can I join if I have a food allergy?",
    answer: "Yes. When you RSVP, you can list any allergies or dietary restrictions. The recipe sign-up also shows what's in each dish, and dishes are labelled with common allergens on the night. You can also email or DM us beforehand if there's anything you want to flag directly."
  },
  {
    question: "Is it free?",
    answer: "Yes. Sauté Sundays is completely free to attend. The only cost is the groceries for the dish you make and bring to share. No ticket, no cover charge, no catch."
  },
  {
    question: "How do I get early access to RSVP?",
    answer: "Events sell out fast, so newsletter subscribers get the RSVP link before spots open publicly. The WhatsApp community is different: we use it for event questions and to flag cancellations or seats that open up in the final 48 hours."
  },
  {
    question: "Where are events held?",
    answer: "We're mainly at Jrew's, 165 Niagara St in downtown Toronto, which fits 35 people. We do host somewhere else occasionally, and when we do, the address for that night goes out with your RSVP confirmation."
  },
  {
    question: "What time should I arrive?",
    answer: "Doors open at 6:15 and we start eating at 6:30. If you're running late, message the WhatsApp group so we know. We won't penalize you, but there is one practical problem: by the time a late dish goes out, most people are already full, so you may carry a lot of it back home."
  },
  {
    question: "Is the venue accessible?",
    answer: "We're mainly at Jrew's, 165 Niagara St. There are no steps at the entrance, and the washroom is on the same level as the table. We occasionally host elsewhere, so if you have a specific access question about a particular night, email us and we'll tell you exactly what to expect."
  },
  {
    question: "What if I can't make it anymore?",
    answer: "Cancel on Luma as early as you can so we can offer your seat to the waitlist. Late cancels move you to the back of the line for early access next month. Life happens and we're not keeping a grudge list, but a seat that goes empty is a seat someone wanted."
  },
  {
    question: "How do I suggest a cookbook?",
    answer: "Send it through our suggestion form, reply to any newsletter, or DM us on Instagram. We actually use these suggestions when we choose each month's book.",
    link: { href: "https://tally.so/r/9qjM0G", label: "Suggest a cookbook" }
  },
];

// 14 questions and answers already live in the array above. Without this they
// are just <details> elements to a crawler, which is the difference between
// being quoted in an AI answer and not being seen at all.
const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.link ? `${faq.answer} ${faq.link.label}: ${faq.link.href}` : faq.answer,
    },
  })),
};
---

<BaseLayout
  jsonLd={faqJsonLd}
  title={`FAQ - ${SITE.name}`}
  description="Frequently asked questions about Sauté Sundays, Toronto's cookbook club. How it works, what to bring, how to RSVP, and more."
  canonical="/faq"
>
  <div class="mx-auto max-w-3xl px-5 py-12">
    <Breadcrumbs items={[{ label: "Home", to: "/" }, { label: "FAQ" }]} />

    <header class="mt-6 mb-12">
      <div class="text-xs font-medium uppercase tracking-[0.2em] text-primary">FAQ</div>
      <h1 class="mt-2 font-serif text-5xl font-semibold leading-[1.05]">
        Questions & answers.
      </h1>
      <p class="mt-4 max-w-xl text-muted-foreground">
        Everything you need to know before your first Sauté Sundays. Still have a question? Email us at <a href={`mailto:${CONTACT.email}`} class="text-primary hover:underline">{CONTACT.email}</a>.
      </p>
    </header>

    <div class="divide-y divide-border">
      {faqs.map((faq, index) => (
        <details class="group py-6" open={index < 2}>
          <summary class="flex cursor-pointer items-center justify-between gap-4 font-serif text-xl font-semibold leading-snug marker:content-none hover:text-primary">
            {faq.question}
            <span class="shrink-0 text-muted-foreground transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-4 text-muted-foreground leading-relaxed">
            {faq.answer}
          </p>
          {faq.link && (
            <a
              href={faq.link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-3 inline-flex min-h-11 items-center gap-1 text-sm font-medium text-primary hover:underline"
            >
              {faq.link.label} <span aria-hidden="true">&#8599;</span>
            </a>
          )}
        </details>
      ))}
    </div>

    <p class="mt-8 text-center text-sm text-muted-foreground">
      Didn't find your answer? Email <a href={`mailto:${CONTACT.email}`} class="text-primary hover:underline">{CONTACT.email}</a>.
    </p>

    <div class="mt-10 rounded-lg border border-border bg-muted/40 px-8 py-10 text-center">
      <p class="font-serif text-2xl font-semibold">Ready to join?</p>
      <p class="mt-2 text-muted-foreground">Sign up for early access before spots open publicly.</p>
      <div class="mt-6 flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground hover:opacity-90 transition-opacity">
          Join the community
        </a>
        <a href="https://lu.ma/sautesundaysto" class="inline-flex items-center gap-2 rounded-full border border-border px-6 py-3 text-sm font-semibold hover:bg-muted transition-colors">
          RSVP on Luma
        </a>
      </div>
    </div>
  </div>
</BaseLayout>