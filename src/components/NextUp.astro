---
import Icon from "./Icon.astro";
import { NEXT_EVENT } from "../config/theme.config.ts";

const event = NEXT_EVENT;

// NEXT_EVENT is updated by hand once the next Luma page is public, which leaves
// a window after an event where this block would still be advertising a date
// that has passed. Once startDateTime is behind us the block stops naming the
// event and asks for a subscribe instead.
//
// Both states are rendered. The server picks one from the build date, and the
// script below re-checks in the browser, because a static build could otherwise
// sit here for days after the event with nothing triggering a rebuild.
const startsAt = event.startDateTime ? new Date(event.startDateTime) : null;
const startsAtValid = startsAt !== null && !Number.isNaN(startsAt.valueOf());
const hasPassed = startsAtValid && startsAt.valueOf() < Date.now();
---

{
  event.title && (
    <section id="next-up" class="scroll-mt-20 border-b border-border/60 bg-muted/40">
      <div
        class="mx-auto max-w-6xl px-5 py-12 sm:py-14"
        data-next-up
        data-starts-at={startsAtValid ? startsAt.toISOString() : undefined}
      >
        <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Next up</div>

        <div class="mt-5 flex flex-col gap-8 md:flex-row md:items-end md:justify-between" data-next-up-live hidden={hasPassed}>
          <div class="max-w-2xl">
            <h2 class="font-serif text-3xl font-semibold leading-tight sm:text-4xl">{event.title}</h2>
            <p class="mt-3 text-muted-foreground">
              {event.date}
              {event.location && <> &middot; {event.location}</>}
            </p>
            {event.cookbook && (
              <p class="mt-1 text-muted-foreground">
                Cooking from <span class="italic">{event.cookbook}</span>
                {event.cookbookAuthor && <> by {event.cookbookAuthor}</>}
              </p>
            )}
            {event.status &&
              (event.statusUrl ? (
                <a
                  href={event.statusUrl}
                  class="mt-4 inline-flex items-center gap-1 text-sm font-medium text-primary hover:underline"
                >
                  {event.status} <Icon name="arrow-right" class="h-3.5 w-3.5" />
                </a>
              ) : (
                <p class="mt-4 text-sm font-medium text-foreground">{event.status}</p>
              ))}
          </div>
          {event.rsvpUrl && (
            <div class="shrink-0">
              <a
                href={event.rsvpUrl}
                class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
              >
                {event.rsvpLabel}
                <Icon name="arrow-right" class="h-3.5 w-3.5" />
              </a>
            </div>
          )}
        </div>

        <div
          class="mt-5 flex flex-col gap-8 md:flex-row md:items-end md:justify-between"
          data-next-up-past
          hidden={!hasPassed}
        >
          <div class="max-w-2xl">
            <h2 class="font-serif text-3xl font-semibold leading-tight sm:text-4xl">
              Next event announced soon
            </h2>
            <p class="mt-3 text-muted-foreground">
              We run one every month. Subscribers hear the date, and the cookbook, before it goes public.
            </p>
          </div>
          <div class="shrink-0">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 rounded-full bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
            >
              Subscribe
              <Icon name="arrow-right" class="h-3.5 w-3.5" />
            </a>
          </div>
        </div>
      </div>
    </section>
  )
}

<script>
  const block = document.querySelector("[data-next-up]");
  const startsAt = block?.dataset.startsAt;

  if (block && startsAt) {
    const passed = new Date(startsAt).valueOf() < Date.now();
    const live = block.querySelector("[data-next-up-live]");
    const past = block.querySelector("[data-next-up-past]");
    if (live) live.hidden = passed;
    if (past) past.hidden = !passed;
  }
</script>
