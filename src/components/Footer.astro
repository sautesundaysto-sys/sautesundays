---
import Icon from "./Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT, SOCIAL_LINKS } from "../config/theme.config.ts";

const { flush = false } = Astro.props;
---

<footer class:list={[flush ? "mt-0" : "mt-24", "border-t border-border/60"]}>
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <img src="/saute-sundays-logo.png" alt="Sauté Sundays" class="h-10 w-auto" />
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground">
        {SITE.blurb}
      </p>
      <p class="mt-4 text-sm text-muted-foreground">
        Email us at <a href={`mailto:${CONTACT.email}`} class="font-medium text-foreground/90 underline underline-offset-4 hover:text-primary">{CONTACT.email}</a>
      </p>
      <div class="mt-3 flex items-center gap-3 text-muted-foreground">
        {
          SOCIAL_LINKS.map((link) => (
            <a href={link.href} aria-label={link.label} class="inline-flex h-11 w-11 items-center justify-center rounded-full hover:bg-muted hover:text-primary">
              <Icon name={link.icon} class="h-4 w-4" />
            </a>
          ))
        }
      </div>
    </div>
    <div>
      <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Navigate</div>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/" class="inline-flex min-h-11 items-center text-foreground/80 hover:text-foreground">Home</a></li>
        <li>
          <a
            href="https://lu.ma/sautesundaysto"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex min-h-11 items-center text-foreground/80 hover:text-foreground">Events ↗</a
          >
        </li>
        <li><a href="/blog" class="inline-flex min-h-11 items-center text-foreground/80 hover:text-foreground">Recaps</a></li>
        <li><a href="/gallery" class="inline-flex min-h-11 items-center text-foreground/80 hover:text-foreground">Gallery</a></li>
        <li><a href="/about" class="inline-flex min-h-11 items-center text-foreground/80 hover:text-foreground">About</a></li>
        <li><a href="/faq" class="inline-flex min-h-11 items-center text-foreground/80 hover:text-foreground">FAQ</a></li>
        <li><a href="/contact" class="inline-flex min-h-11 items-center text-foreground/80 hover:text-foreground">Subscribe</a></li>
      </ul>
        
    
    </div>
    <div>
      <div class="text-xs font-medium uppercase tracking-wider text-muted-foreground">Work with us</div>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/restaurant-nights" class="inline-flex min-h-11 items-center text-foreground/80 hover:text-foreground">Restaurant nights</a></li>
        <li><a href="/partners" class="inline-flex min-h-11 items-center text-foreground/80 hover:text-foreground">Partner with us</a></li>
      </ul>

      <div class="mt-8 text-xs font-medium uppercase tracking-wider text-muted-foreground">From Tammy</div>
      <ul class="mt-3 space-y-2 text-sm">
        <li>
          <a href="https://clearingthetable.substack.com" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center text-foreground/80 hover:text-primary">
            Clearing the Table ↗
          </a>
        </li>
        <li class="text-xs text-muted-foreground">Food writing, travel & recipes on Substack</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border/60">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-2 px-5 py-5 text-xs text-muted-foreground sm:flex-row sm:items-center">
      <div>&copy; {new Date().getFullYear()} Sauté Sundays. Toronto's cookbook club. 💛</div>
      <div>Made with love in Toronto.</div>
    </div>
  </div>
</footer>