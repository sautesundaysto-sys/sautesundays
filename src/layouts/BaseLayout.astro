---
import "../styles.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, imageSrc, authors } from "../lib/blog-data.js";
import { CONTACT } from "../config/theme.config.ts";

const {
  title = `${SITE.name} - Toronto's Cookbook Club`,
  description = SITE.description,
  canonical,
  ogType = "website",
  ogImage,
  ogImageAlt,
  ogImageWidth,
  ogImageHeight,
  jsonLd,
  flushFooter = false,
} = Astro.props;

// Without a fallback, any page that is not a blog post shares as a blank card.
const DEFAULT_OG_IMAGE = "/og-default.jpg";
const DEFAULT_OG_ALT =
  "A full table of homemade dishes at Sauté Sundays, Toronto's cookbook club";

const siteUrl = Astro.site?.toString() || SITE.url;
const absoluteUrl = (value) => {
  const src = imageSrc(value) || value;
  if (!src) return undefined;

  try {
    return new URL(src, siteUrl).toString();
  } catch {
    return src;
  }
};
const canonicalUrl = absoluteUrl(canonical || Astro.url.pathname);
const usingDefaultOgImage = !imageSrc(ogImage) && !ogImage;
const ogImageUrl = absoluteUrl(usingDefaultOgImage ? DEFAULT_OG_IMAGE : ogImage);
// Only declared when we know the real size. Claiming the wrong dimensions is
// worse than omitting them, so a post's own cover stays undeclared.
const ogWidth = ogImageWidth ?? (usingDefaultOgImage ? 1200 : undefined);
const ogHeight = ogImageHeight ?? (usingDefaultOgImage ? 630 : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {
      ogWidth && ogHeight && (
        <>
          <meta property="og:image:width" content={String(ogWidth)} />
          <meta property="og:image:height" content={String(ogHeight)} />
        </>
      )
    }
    <meta
      property="og:image:alt"
      content={ogImageAlt || (usingDefaultOgImage ? DEFAULT_OG_ALT : title)}
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/png" href="/saute-sundays-logo.png" />
   
    
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          var dark = theme
            ? theme === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
        } catch (error) {}
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": SITE.name,
      "alternateName": "Toronto Cookbook Club",
      "description": SITE.description,
      "url": siteUrl.replace(/\/$/, ""),
      "logo": absoluteUrl("/saute-sundays-logo.png"),
      "image": absoluteUrl(DEFAULT_OG_IMAGE),
      "email": CONTACT.email,
      "foundingDate": "2025",
      "areaServed": { "@type": "City", "name": "Toronto" },
      "contactPoint": [
        {
          "@type": "ContactPoint",
          "contactType": "sales",
          "name": "Brand and restaurant partnerships",
          "email": CONTACT.email,
          "areaServed": "CA",
          "availableLanguage": "English"
        }
      ],
      "sameAs": [
        CONTACT.socialUrl,
        "https://lu.ma/sautesundaysto"
      ],
      "founder": authors.map((author) => ({ "@type": "Person", "name": author.name }))
    })} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <div class="flex min-h-dvh flex-col">
      <Header />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <Footer flush={flushFooter} />
    </div>
  </body>
</html>
